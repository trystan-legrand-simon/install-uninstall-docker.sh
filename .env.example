# Copier ce fichier en .env puis adapter les valeurs :
#   cp .env.example .env && chmod 600 .env
# Pas de guillemets ni d'espaces en fin de ligne.

# ============================================================
#  Commun à install-docker.sh et uninstall-docker.sh
# ============================================================

# --- Proxy (laisser vide si pas de proxy) ---
PROXY_HTTP=http://proxy.exemple.com:8080
PROXY_HTTPS=http://proxy.exemple.com:8080
# localhost, 127.0.0.1 et ::1 sont ajoutés automatiquement
PROXY_NO=.exemple.local,192.168.1.0/24,172.16.0.0/12

# --- Utilisateur à ajouter au groupe docker / dont le config.json est géré ---
DOCKER_USER=

# --- 1 = aucune question posée ---
NONINTERACTIVE=1

# ============================================================
#  install-docker.sh uniquement
# ============================================================

# --- DNS des conteneurs (optionnel, séparés par des virgules) ---
DOCKER_DNS=

# --- Codename Debian/Ubuntu forcé (optionnel, ex: bookworm, trixie, noble) ---
DOCKER_CODENAME=

# ============================================================
#  uninstall-docker.sh uniquement
# ============================================================

# --- 1 = supprime images, conteneurs et volumes (/var/lib/docker) ---
REMOVE_DATA=0

# --- 1 = supprime le groupe docker ---
REMOVE_GROUP=0
